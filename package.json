{
  "name": "obsidian-markdown",
  "version": "0.1.0",
  "description": "Render Obsidian Flavored Markdown with markdown-it, plus Lit web components for notes and their properties.",
  "keywords": [
    "obsidian",
    "markdown",
    "markdown-it",
    "web-components",
    "lit",
    "custom-elements"
  ],
  "homepage": "https://github.com/gordonbrander/obsidian-markdown#readme",
  "bugs": {
    "url": "https://github.com/gordonbrander/obsidian-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gordonbrander/obsidian-markdown.git"
  },
  "license": "MIT",
  "author": "Gordon Brander",
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json",
    "LICENSE-MIT"
  ],
  "exports": {
    ".": "./dist/render.js",
    "./components/ofm-note.js": "./dist/components/ofm-note.js",
    "./components/ofm-markdown.js": "./dist/components/ofm-markdown.js",
    "./components/ofm-frontmatter.js": "./dist/components/ofm-frontmatter.js",
    "./components/ofm-proprow.js": "./dist/components/ofm-proprow.js",
    "./ofm-theme.js": "./dist/ofm-theme.js",
    "./adopt-sheet.js": "./dist/adopt-sheet.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/components/ofm-note.js",
    "./dist/components/ofm-markdown.js",
    "./dist/components/ofm-frontmatter.js",
    "./dist/components/ofm-proprow.js",
    "./dist/tex.js",
    "./src/components/*.ts",
    "./src/tex.ts"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cem analyze",
    "build:examples": "vite build",
    "prepack": "npm run build",
    "test": "node --test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "lit": "^3.3.3",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "refractor": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
